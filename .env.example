# Halaxy API credentials (from the practice's Halaxy developer settings).
# Used only by the Integration test suite (composer test:integration).
HALAXY_CLIENT_ID=
HALAXY_CLIENT_SECRET=
HALAXY_REGION=au

# IDs of the curated test patients in the connected Halaxy practice.
# Comma-separated; order matters: first = "Test, Patient", second =
# "Test, Another". Keep these pinned — Halaxy drops `identifier` on create,
# so an unpinned lifecycle run that fails to find a sentinel by name will
# create a duplicate (and Halaxy has no Patient delete to undo it).
HALAXY_TEST_PATIENT_IDS=

# Allow integration tests to create/update records in the practice.
# Halaxy has no Patient delete API, so every created test patient stays in
# the practice permanently. Only enable with the practice owner's agreement.
HALAXY_ALLOW_WRITES=false

# Webhooks are disabled by default and fail closed without a signing secret.
HALAXY_WEBHOOKS_ENABLED=false
HALAXY_WEBHOOK_SECRET=
